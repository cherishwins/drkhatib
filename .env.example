# Public site URL — used in metadata, canonical links, sitemap
NEXT_PUBLIC_SITE_URL=https://miladkhatib.com

# Resend API key — contact form delivery
RESEND_API_KEY=

# Umami website ID — analytics. Optional: a default ID is hardcoded in
# components/khatib/Analytics.tsx so the script works out of the box. Set this
# to override per environment (dev/preview/prod) or to disable by leaving blank
# and removing the fallback.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=d620efb1-b66d-40e2-a412-dbad60862b72
